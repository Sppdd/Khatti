# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app.

# Khatti API (khatti/api.py). Leave empty to start in demo mode; can also be set in the Lab tab.
EXPO_PUBLIC_KHATTI_API_URL=
EXPO_PUBLIC_KHATTI_API_KEY=

# Supabase project (Settings -> API). Leave empty to keep data on the device only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
