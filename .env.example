# Nebius Token Factory (OpenAI-compatible). Confirm the base URL in your Nebius console.
KHATTI_TOKEN_FACTORY_URL=https://api.studio.nebius.com/v1
KHATTI_TOKEN_FACTORY_KEY=
KHATTI_ROUTER_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5

# Image reader ensemble. Include the NVIDIA VLM on your Nebius Serverless Endpoint.
KHATTI_READERS=[{"name":"nvidia-vlm","base_url":"https://<your-serverless-endpoint>/v1","model":"<nvidia-vlm-model>","api_key":"<endpoint-key>"},{"name":"arabic-vlm","base_url":"https://api.studio.nebius.com/v1","model":"Qwen/Qwen2.5-VL-72B-Instruct"}]

KHATTI_MIN_CONFIDENCE=0.85

# Vision model for /v1/extract (mobile app). Optional: defaults to the first reader above.
# KHATTI_EXTRACTOR={"name":"extractor","base_url":"https://api.studio.nebius.com/v1","model":"Qwen/Qwen2.5-VL-72B-Instruct"}

# Optional shared secret; clients send "Authorization: Bearer <key>".
KHATTI_API_KEY=
