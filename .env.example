# ---------------------------------------------------------------- Nebius Token Factory
KHATTI_TOKEN_FACTORY_URL=https://api.tokenfactory.nebius.com/v1
KHATTI_TOKEN_FACTORY_KEY=
# Model tiers. Confirm IDs on your key: curl -H "Authorization: Bearer $KEY" "$URL/models?verbose=true"
KHATTI_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
KHATTI_STRUCTURER_MODEL=nvidia/nemotron-3-super-120b-a12b
KHATTI_REVIEWER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# ---------------------------------------------------------------- image readers (JSON list)
# Reader A: NVIDIA Nemotron 3 Nano Omni FP8 via vLLM on a Nebius Serverless Endpoint (services/reader-omni).
# Reader B: an Arabic-capable open VLM on Token Factory, sampled 3x for self-consistency (verify availability).
# "json_mode": false for endpoints that reject response_format.
KHATTI_READERS=[{"name":"nvidia-omni","vendor":"nvidia","base_url":"https://<serverless-endpoint>/v1","model":"nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-FP8","api_key":"<endpoint-token>"},{"name":"arabic-vlm","base_url":"https://api.tokenfactory.nebius.com/v1","model":"Qwen/Qwen2.5-VL-72B-Instruct","samples":3}]
# Bake-off outcome: primary reader per field group (names | digits | dates | enums | text)
KHATTI_PRIMARY_READERS={}
# Fitted calibrator artifact from jobs/calibrate (empty: uncalibrated heuristic weights)
KHATTI_CALIBRATOR_PATH=
KHATTI_TAU_DOC=0.8

# ---------------------------------------------------------------- data
KHATTI_DATABASE_URL=postgresql://khatti_app:khatti_app@localhost:5432/khatti
# python -m khatti.admin gen-data-key  (envelope-encryption master key + HMAC key; keep secret)
KHATTI_DATA_KEY=
# >= 32 random bytes; signs reviewer/app JWTs
KHATTI_JWT_SECRET=
KHATTI_RETENTION_DAYS=30
# Nebius Object Storage (S3 API). Empty bucket: local directory + PUT /v1/uploads/{token}.
KHATTI_S3_BUCKET=
KHATTI_S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
KHATTI_S3_REGION=eu-north1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KHATTI_LOCAL_STORAGE_DIR=./data/objects
KHATTI_PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- partners
KHATTI_RATE_LIMIT_PER_MINUTE=120
# Optional allowlist of webhook hosts (http allowed only for allowlisted hosts)
KHATTI_WEBHOOK_ALLOWED_HOSTS=
