# --- Nebius Token Factory (OpenAI-compatible) ---
KHATTI_TOKEN_FACTORY_URL=https://api.tokenfactory.nebius.com/v1
KHATTI_TOKEN_FACTORY_KEY=
# Model tiers. Confirm IDs with: curl -H "Authorization: Bearer $KEY" "$URL/models?verbose=true"
KHATTI_ROUTER_MODEL=nvidia/Nemotron-3_5-Lightning
KHATTI_STRUCTURER_MODEL=nvidia/nemotron-3-super-120b-a12b
KHATTI_REVIEWER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Image reader ensemble (JSON list) ---
# nvidia-omni: Nemotron 3 Nano Omni FP8 via vLLM on a Nebius Serverless Endpoint (GPU L40S).
# arabic-vlm: an Arabic-capable open VLM on Token Factory (verify which is served on your key).
# Set "json_mode": false for any endpoint that rejects response_format.
KHATTI_READERS=[{"name":"nvidia-omni","vendor":"nvidia","base_url":"https://<serverless-endpoint>/v1","model":"nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-FP8","api_key":"<endpoint-token>"},{"name":"arabic-vlm","base_url":"https://api.tokenfactory.nebius.com/v1","model":"Qwen/Qwen2.5-VL-72B-Instruct"}]

KHATTI_MIN_CONFIDENCE=0.85

# --- Case queue and storage (async /v1/cases) ---
KHATTI_DATABASE_URL=postgresql://khatti:khatti@localhost:5432/khatti
# Nebius Object Storage (S3 API). Leave KHATTI_S3_BUCKET empty to store images in KHATTI_LOCAL_STORAGE_DIR.
KHATTI_S3_BUCKET=
KHATTI_S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
KHATTI_S3_REGION=eu-north1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Partner access ---
# Comma-separated API keys; empty disables auth (local development only).
KHATTI_API_KEYS=
# HMAC-SHA256 secret for the X-Khatti-Signature webhook header.
KHATTI_WEBHOOK_SECRET=
# Optional comma-separated allowlist of callback hosts.
KHATTI_WEBHOOK_ALLOWED_HOSTS=
